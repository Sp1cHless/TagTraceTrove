{
  "name": "@t3/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:doctor": "tsx src/database/doctor-cli.ts",
    "db:probe": "tsx src/database/probe-cli.ts",
    "db:backup": "tsx src/database/backup-cli.ts",
    "db:restore": "tsx src/database/restore-cli.ts",
    "dev": "tsx --watch src/http/server-cli.ts",
    "import:commit": "tsx src/import/commit-cli.ts",
    "import:site-probe": "tsx src/import/cli.ts",
    "merge:authors": "tsx src/import/merge-producers-cli.ts",
    "media:thumbnails": "tsx src/import/thumbnail-backfill-cli.ts",
    "start": "tsx src/http/server-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@t3/shared": "workspace:*",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.13.5",
    "jsdom": "^30.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "tsx": "^4.23.13"
  }
}
