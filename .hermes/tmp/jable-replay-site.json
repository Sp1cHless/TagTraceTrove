{
  "key": "jable.tv",
  "display_name": "jable.tv",
  "tool": "listing",
  "source_site": "jable.tv",
  "export_group": "jable.tv",
  "media_id_prefix": "",
  "hosts": [
    "jable.tv"
  ],
  "targets": {
    "artist": {
      "url_pattern": "^https?://jable\\.tv/models/.*"
    }
  },
  "listings": {
    "artist": {
      "document": "listing_html",
      "row_selector": {
        "select": "div.col-6.col-sm-4",
        "scope": "section.pb-3.pb-e-lg-40"
      },
      "fields": {
        "source_id": {
          "from": "html",
          "document": "listing_html",
          "select": "div.img-box.cover-md a",
          "attr": "href",
          "matches": 1,
          "filter": [
            "/videos/([^/]+)(?=[/?#]|$)"
          ],
          "group": 1
        },
        "cover_url": {
          "from": "html",
          "document": "listing_html",
          "select": "img",
          "attr": "data-src",
          "matches": 1
        },
        "detail_url": {
          "from": "html",
          "document": "listing_html",
          "select": "div.img-box.cover-md a",
          "attr": "href",
          "matches": 1,
          "absolute": true
        }
      },
      "_builder": {
        "cards": 24,
        "hints": [
          "url",
          "title",
          "cover",
          "id"
        ],
        "missing": [
          "title"
        ]
      }
    }
  },
  "documents": {
    "listing_html": {
      "format": "markup"
    }
  }
}