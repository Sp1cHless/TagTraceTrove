
it('origin existing root freezes pending child identity and held create blocks deletion before exact SQL settlement',async()=>{
 const f=await fixture();try{await f.offline();const child=await f.api.createCollection({kind:'entry',title:'Local child',parentId:f.parent.id});const create=(await f.store.list())[0]!;await f.store.update(create.opId,{status:'conflict'});await f.api.deleteCollection(f.parent.id);const rows=await f.store.list();const deletion=originalMutationEnvelope(rows[1]!);if(deletion.operationKind!=='collection.delete')throw new Error('fixture');expect(deletion.baseValues.children).toContainEqual({syncUid:create.entityUid,syncVersion:1});expect(mutationQueuePlan(rows).get(deletion.opId)?.dependencies).toContain(create.opId);f.connect();await f.cold().flushOfflineOutbox!();expect(f.bodies).toEqual([]);expect(f.db.prepare('SELECT id FROM collections WHERE id=?').get(f.parent.id)).toBeDefined();await f.store.update(create.opId,{status:'pending'});f.loseAck();await f.cold().flushOfflineOutbox!();expect((await f.store.list()).map(originalMutationEnvelope)).toEqual(rows.map(originalMutationEnvelope));await f.cold().flushOfflineOutbox!();expect(await f.store.list()).toEqual([]);expect(f.db.prepare('SELECT id FROM collections WHERE title=?').get('Local child')).toBeUndefined();expect(child.id).toBeLessThan(0);
 }finally{f.close();}
});
it('origin local root and child cold delete survives actual SQL response and ACK loss without cascading subjects or peer tags',async()=>{
 const f=await fixture();try{await f.online.addCollectionTag(f.peer.id,'Winter');await f.offline();const root=await f.api.createCollection({kind:'entry',title:'Origin cascade',galleryType:'Comic'});const child=await f.api.createCollection({kind:'entry',title:'Origin child',parentId:root.id});const creates=await f.store.list();await f.api.deleteCollection(root.id);const originals=(await f.store.list()).map(originalMutationEnvelope);const deletion=originals[2]!;if(deletion.operationKind!=='collection.delete')throw new Error('fixture');expect(deletion.entityUid).toBe(creates[0]!.entityUid);expect(deletion.baseVersion).toBe(1);expect(deletion.baseValues.children).toEqual([{syncUid:creates[1]!.entityUid,syncVersion:1}]);const cold=f.cold();await cold.preferOfflineSnapshot!();expect((await cold.listCollections('entry',true)).some(row=>row.id===root.id || row.children.some(c=>c.id===child.id))).toBe(false);f.connect();f.loseReplay();await cold.flushOfflineOutbox!();expect(f.db.prepare('SELECT count(*) FROM collections WHERE title=?').pluck().get('Origin cascade')).toBe(1);f.loseAck();await f.cold().flushOfflineOutbox!();expect((await f.store.list()).map(originalMutationEnvelope)).toEqual(originals);expect(f.db.prepare('SELECT count(*) FROM collections WHERE title LIKE ?').pluck().get('Origin %')).toBe(0);await f.cold().flushOfflineOutbox!();expect(await f.store.list()).toEqual([]);for(const op of originals){const bodies=f.bodies.filter(body=>JSON.parse(body).opId===op.opId);expect(new Set(bodies).size).toBe(1);expect(bodies.length).toBeGreaterThan(1);}expect(f.db.prepare('SELECT count(*) FROM entries').pluck().get()).toBe(3);expect(f.db.prepare('SELECT count(*) FROM producers').pluck().get()).toBe(1);expect(f.db.prepare('SELECT count(*) FROM entry_producers').pluck().get()).toBe(1);expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);expect(f.db.prepare('SELECT count(*) FROM collection_entries WHERE collection_id=?').pluck().get(f.peer.id)).toBe(1);
 }finally{f.close();}
});
it('origin attempted create delete export restores atomically with original metadata and rejects a schema-valid deleted-child write',async()=>{
 const f=await fixture();try{await f.offline();const root=await f.api.createCollection({kind:'entry',title:'Restored origin',galleryType:'Comic'});await f.api.createCollection({kind:'entry',title:'Restored child',parentId:root.id});await f.api.deleteCollection(root.id);f.connect();f.loseReplay();await f.api.flushOfflineOutbox!();const saved=await f.store.list();expect(saved[0]!.lastAttemptAt).not.toBeNull();const text=JSON.stringify(await buildPendingWorkExport(f.store));await preparePendingWork(text);await f.store.removeMany(saved.map(row=>row.opId));const cold=f.cold();await cold.restorePendingWork!(text);expect(await f.store.list()).toEqual(saved);const value=JSON.parse(text);const deletion=value.operations[2];const later={...deletion,opId:randomUUID(),entityUid:deletion.baseValues.children[0].syncUid,operationKind:'collection.update',baseVersion:2,clientCreatedAt:new Date(Date.parse(deletion.clientCreatedAt)+1000).toISOString(),baseValues:{title:'Restored child'},payload:{title:'Invalid later'},status:'pending',lastAttemptAt:null,lastError:null};const {status,lastAttemptAt,lastError,...envelope}=later;void status;void lastAttemptAt;void lastError;expect(syncReplayRequestSchema.safeParse(envelope).success).toBe(true);value.operations.push(later);expect(pendingWorkFileSchema.safeParse(value).success).toBe(true);await preparePendingWork(JSON.stringify(value));await expect(cold.restorePendingWork!(JSON.stringify(value))).rejects.toThrow('deleted Collection child');expect(await f.store.list()).toEqual(saved);f.loseAck();await cold.flushOfflineOutbox!();const attempted=await f.store.list();expect(attempted.every(row=>row.lastAttemptAt!==null)).toBe(true);const afterAck=JSON.stringify(await buildPendingWorkExport(f.store));await f.store.removeMany(attempted.map(row=>row.opId));const final=f.cold();await final.restorePendingWork!(afterAck);expect(await f.store.list()).toEqual(attempted);await final.flushOfflineOutbox!();expect(await f.store.list()).toEqual([]);for(const op of saved){expect(new Set(f.bodies.filter(body=>JSON.parse(body).opId===op.opId)).size).toBe(1);}
 }finally{f.close();}
});
