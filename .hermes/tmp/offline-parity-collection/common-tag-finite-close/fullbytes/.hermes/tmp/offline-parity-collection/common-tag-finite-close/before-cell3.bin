import { randomUUID } from 'node:crypto';
import { mkdtempSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { IDBFactory } from 'fake-indexeddb';
import { expect, it, vi } from 'vitest';
import { mount, flushPromises } from '@vue/test-utils';
vi.hoisted(async () => {
  const { JSDOM } = await import('jsdom');
  const window = new JSDOM('<!doctype html><html><body></body></html>', { url: 'http://isolated/' }).window;
  for (const key of ['window', 'document', 'Element', 'HTMLElement', 'SVGElement', 'Node', 'localStorage', 'sessionStorage', 'MutationObserver', 'navigator', 'getComputedStyle']) {
    Object.defineProperty(globalThis, key, { value: key === 'window' ? window : window[key as keyof typeof window], configurable: true });
  }
});
import CollectionsPage from '../src/CollectionsPage.vue';
import { buildPendingWorkExport } from '../src/offline/pending-work-export.js';
import { operationFingerprint } from '../src/offline/outbox-store.js';
import { setLocale } from '../src/i18n.js';
import { showNsfw } from '../src/stores/preferences.js';
import { createGalleryApi } from '../src/api/gallery.js';
import { createApiClient } from '../src/api/client.js';
import { createIndexedDbOfflineStore } from '../src/offline/indexeddb-snapshot-store.js';
import { createOfflineAwareGalleryApi } from '../src/offline/offline-api.js';

const serverModule = async (path: string) => {
  const target = `../../server/src/${path}.js`;
  return import(/* @vite-ignore */ target);
};
async function fixture() {
  const { createMigratedMemoryDatabase } = await serverModule('database/testing');
  const { createApiApp } = await serverModule('http/app');
  const { createEntry } = await serverModule('repositories/entry-repository');
  const { createProducer, linkEntryProducer } = await serverModule('repositories/producer-repository');
  const { createSection } = await serverModule('repositories/layout-repository');
  const { createCollection, addCollectionEntry } = await serverModule('repositories/collection-repository');
  const db = createMigratedMemoryDatabase();
  const root = mkdtempSync(join(tmpdir(), 't3-collection-parity-'));
  const section = createSection(db, { entryType: 'Comic', name: 'Tags' });
  const work = createEntry(db, { title: 'Shared work', type: 'Comic' });
  const other = createEntry(db, { title: 'Child work', type: 'Comic' });
  const skipped = createEntry(db, { title: 'Unstructured work', type: 'Unstructured' });
  const author = createProducer(db, { name: 'Surviving Author' });
  linkEntryProducer(db, work.id, author.id);
  const parent = createCollection(db, { kind: 'entry', title: 'Shelf', galleryType: 'Comic' });
  const child = createCollection(db, { kind: 'entry', title: 'Child shelf', parentId: parent.id });
  const peer = createCollection(db, { kind: 'entry', title: 'Peer shelf', galleryType: 'Comic' });
  for (const folder of [parent, child, peer]) addCollectionEntry(db, folder.id, work.id);
  addCollectionEntry(db, child.id, other.id);
  addCollectionEntry(db, parent.id, skipped.id);
  addCollectionEntry(db, child.id, skipped.id);
  const app = createApiApp(db, { assetRoot: join(root, 'assets'), dataDir: root });
  const calls: string[] = [];
  let disconnected = false;
  let responseTamper: ((path:string,response:Response)=>Promise<Response>) | undefined;
  let loseReplay=false,loseAck=false;const bodies:string[]=[];let downgraded=false;
  const online = createGalleryApi(createApiClient({ baseUrl: 'http://isolated/api', fetchImplementation: async (input, init) => {
    const url = new URL(String(input));
    calls.push(`${init?.method ?? 'GET'} ${url.pathname}`);
    if (disconnected) throw new TypeError('Known offline');
    if(url.pathname==='/api/sync/replay')bodies.push(String(init?.body));
    let response=await app.request(url.pathname + url.search, init);
    if(downgraded && url.pathname==='/api/sync/capabilities'){const data=await response.json();data.featureFlags.offlineCollectionCommonTag=false;response=new Response(JSON.stringify(data),{status:200,headers:{'content-type':'application/json'}});}
    if(loseReplay && url.pathname==='/api/sync/replay' && response.ok){loseReplay=false;throw new TypeError('Lost SQL response');}
    if(loseAck && url.pathname.includes('/ack') && response.ok){loseAck=false;throw new TypeError('Lost ACK response');}
    return responseTamper ? responseTamper(url.pathname,response) : response;
  } }));
  const indexedDB=new IDBFactory(),databaseName=randomUUID();
  let store = createIndexedDbOfflineStore({ indexedDB, databaseName });
  const api = createOfflineAwareGalleryApi(online, store, { clientId: 'collection-parity-phone', randomUUID });
  return { db, section, work, other, skipped, author, parent, child, peer, online, api, calls, bodies, get store(){return store;},
    tamperResponse(hook:typeof responseTamper){responseTamper=hook;},
    reconnect(){disconnected=false;},loseResponse(){loseReplay=true;},loseAcknowledgement(){loseAck=true;},downgrade(){downgraded=true;},
    async deleteCapability(flag:string) {
      const database=await new Promise<IDBDatabase>((resolve,reject)=>{const request=indexedDB.open(databaseName);request.onsuccess=()=>resolve(request.result);request.onerror=()=>reject(request.error);});
      await new Promise<void>((resolve,reject)=>{const tx=database.transaction('meta','readwrite');tx.objectStore('meta').delete('capability.'+flag);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);});database.close();
    },
    cold(){store.close();store=createIndexedDbOfflineStore({indexedDB,databaseName});return createOfflineAwareGalleryApi(online,store,{clientId:'collection-parity-phone',randomUUID});},
    async offline() {
      await store.writeGeneration(1, JSON.stringify(await online.fetchSyncSnapshot()));
      await store.writeMeta('activeGeneration', '1');
      await api.getSyncCapabilities({ replay: false });
      await api.preferOfflineSnapshot!();
      disconnected = true;
      calls.length = 0;
    },
    close() { store.close(); db.close(); rmSync(root, { recursive: true, force: true }); },
  };
}
const settle = async () => { for (let i = 0; i < 20; i++) { await flushPromises(); await new Promise(resolve=>setTimeout(resolve,5)); } };

// Finite class 1 tracer: real ordinary caller, not a facade-only rejection test.
it('ordinary common-tag offline caller atomically tags unique current/direct-child Works without business HTTP', async () => {
  const f = await fixture();
  setLocale('en'); showNsfw.value = true;
  vi.stubGlobal('scrollTo', vi.fn());
  await f.offline();
  const wrapper = mount(CollectionsPage, { props: { api: f.api } });
  try {
    await settle();
    await wrapper.get(`[data-collection-id="${f.parent.id}"]`).trigger('click');
    await settle();
    await wrapper.get('[data-testid="collections-edit-toggle"]').trigger('click');
    await wrapper.get('[data-testid="collection-common-tag-toggle"]').trigger('click');
    await wrapper.get('[data-testid="collection-common-tag-input"]').setValue('  Winter  ');
    await wrapper.get('[data-testid="collection-common-tag-form"]').trigger('submit');
    await settle();
    expect(f.calls).toEqual([]);
    expect(wrapper.get('[data-testid="collection-common-tag-result"]').text()).toBe('Tagged 2 works (0 already had it, 1 skipped).');
    const rows = await f.store.list();
    expect(rows).toHaveLength(1);
    // Durable staging is local intent only; real SQL has not yet been replayed.
    expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(0);
    const first = await f.api.getEntry(f.work.id);
    const second = await f.api.getEntry(f.other.id);
    expect(JSON.stringify(first)).toContain('Winter');
    expect(JSON.stringify(second)).toContain('Winter');
  } finally { wrapper.unmount(); f.close(); vi.unstubAllGlobals(); }
});

// Prerequisite evidence only: existing per-Entry envelopes cannot replace atomic bulk replay.
// This first-GREEN test is not an implemented common-tag matrix cell.
it('prerequisite existing Entry inline-tag replay commits one owner before a second-owner conflict', async () => {
  const f = await fixture();
  try {
    const identity = await f.online.getSyncCapabilities();
    const facetId = Number(f.db.prepare("SELECT id FROM tag_groups WHERE entry_type='Comic' AND group_kind='facet' AND name='' ORDER BY id LIMIT 1").pluck().get());
    const operation = (entryId: number, offset = 0) => {
      const row = f.db.prepare('SELECT sync_uid AS syncUid, sync_version AS syncVersion FROM entries WHERE id=?').get(entryId) as {syncUid:string;syncVersion:number};
      return {opId:randomUUID(),clientId:'collection-parity-phone',libraryId:identity.libraryId,syncEpoch:identity.syncEpoch,
        entityKind:'entry' as const,entityUid:row.syncUid,operationKind:'entry.tags.set' as const,
        baseVersion:row.syncVersion+offset,baseValues:{tags:[]},payload:{tags:[{name:'Winter',facetId}]},clientCreatedAt:new Date().toISOString()};
    };
    const first = operation(f.work.id);
    const second = operation(f.other.id, 1);
    expect(await f.online.replaySyncOperation!(first)).toMatchObject({opId:first.opId,status:'applied'});
    expect(await f.online.replaySyncOperation!(second)).toMatchObject({opId:second.opId,status:'conflict'});
    expect(f.db.prepare('SELECT entry_id AS entryId FROM entry_tags ORDER BY entry_id').all()).toEqual([{entryId:f.work.id}]);
    expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id IN (?,?)').pluck().get(first.opId,second.opId)).toBe(2);
    expect(await f.online.replaySyncOperation!(first)).toMatchObject({opId:first.opId,status:'applied'});
    expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(1);
  } finally { f.close(); }
});

// Real production SQL, response loss, full cold-IDB reopen and durable ACK boundary.
it('single bulk SQL receipt survives response loss and cold ACK retry with the original UUID/body',async()=>{
 const f=await fixture();try{
  await f.offline();const result=await f.api.addCollectionTag(f.parent.id,' Winter ');
  expect(result).toMatchObject({entriesAffected:2,alreadyPresent:0,skipped:1});
  const original=(await f.store.list())[0]!;const fingerprint=operationFingerprint(original);
  const exported=JSON.stringify(await buildPendingWorkExport(f.store));await f.store.removeMany([original.opId]);
  let cold=f.cold();await cold.restorePendingWork!(exported);expect(operationFingerprint((await f.store.list())[0]!)).toBe(fingerprint);
  await cold.preferOfflineSnapshot!();
  expect(JSON.stringify(await cold.getEntry(f.other.id))).toContain('Winter');
  f.reconnect();f.loseResponse();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);
  expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(original.opId)).toBe(1);
  expect(operationFingerprint((await f.store.list())[0]!)).toBe(fingerprint);
  const receipt=f.db.prepare('SELECT result_json FROM sync_operation_receipts WHERE op_id=?').pluck().get(original.opId);
  cold=f.cold();f.loseAcknowledgement();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(await f.store.list()).toHaveLength(1);
  expect(f.bodies).toHaveLength(2);expect(f.bodies[1]).toBe(f.bodies[0]);
  cold=f.cold();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(await f.store.list()).toEqual([]);
  expect(f.db.prepare('SELECT result_json FROM sync_operation_receipts WHERE op_id=?').pluck().get(original.opId)).toBe(receipt);
  expect(f.bodies.every(body=>body===f.bodies[0])).toBe(true);
  expect(JSON.stringify(await cold.getEntry(f.work.id))).toContain('Winter');
 }finally{f.close();}
});
it('bulk validates every frozen Entry before mutation and rolls back assignments Tag journal and receipt on SQL failure',async()=>{
 const f=await fixture();try{
  await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');
  const row=(await f.store.list())[0]!;const {status,lastAttemptAt,lastError,...operation}=row;void status;void lastAttemptAt;void lastError;
  const baseline=()=>['tags','entry_tags','sync_changes','sync_operation_receipts'].map(table=>f.db.prepare(`SELECT count(*) FROM ${table}`).pluck().get());
  const before=baseline();f.reconnect();
  f.db.exec(`CREATE TEMP TRIGGER reject_second_bulk BEFORE INSERT ON entry_tags WHEN (SELECT count(*) FROM entry_tags)>=1 BEGIN SELECT RAISE(ABORT,'forced second assignment failure'); END;`);
  await expect(f.online.replaySyncOperation!(operation as Parameters<NonNullable<typeof f.online.replaySyncOperation>>[0])).rejects.toThrow();
  expect(baseline()).toEqual(before);f.db.exec('DROP TRIGGER reject_second_bulk');
  f.db.prepare('UPDATE entries SET title=? WHERE id=?').run('Concurrent changed member',f.other.id);
  const changed=baseline();
  expect(await f.online.replaySyncOperation!(operation as Parameters<NonNullable<typeof f.online.replaySyncOperation>>[0])).toMatchObject({status:'conflict'});
  expect(baseline().slice(0,3)).toEqual(changed.slice(0,3));
  expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(0);
 }finally{f.close();}
});
it('a rejected durable enqueue creates neither partial queue nor optimistic Tag projection',async()=>{
 const f=await fixture();try{await f.offline();const spy=vi.spyOn(f.store,'enqueue').mockRejectedValueOnce(new Error('IDB abort'));
  await expect(f.api.addCollectionTag(f.parent.id,'Winter')).rejects.toThrow('IDB abort');spy.mockRestore();
  expect(await f.store.list()).toEqual([]);expect(JSON.stringify(await f.api.getEntry(f.work.id))).not.toContain('Winter');
 }finally{f.close();}
});

it('bulk forecasts its real Entry delta and schedules a later Entry write after the frozen bulk',async()=>{
 const f=await fixture();try{
  await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');
  await f.api.updateEntry(f.work.id,{title:'After bulk'});
  const rows=await f.store.list();expect(rows).toHaveLength(2);
  const bulk=rows[0]!;const next=rows[1]!;
  const member=(bulk.baseValues.members as Array<{syncUid:string;syncVersion:number}>).find(row=>row.syncUid===next.entityUid)!;
  expect(next.baseVersion).toBe(member.syncVersion+1);
  f.reconnect();await f.api.getSyncCapabilities({replay:false});await f.api.replayOfflineOperations!();
  expect(f.db.prepare('SELECT title FROM entries WHERE id=?').pluck().get(f.work.id)).toBe('After bulk');
  expect(await f.store.list()).toEqual([]);
  expect(f.bodies.map(body=>JSON.parse(body).operationKind)).toEqual(['collection.common-tag.add','entry.update']);
 }finally{f.close();}
});

// Retained finite class A: compare with the actual ordinary online writer, not invented cleaning rules.
it('retained normalization and global majority match real online counts placement and cold SQL projection',async()=>{
 for(const scene of [
  {name:'  ＷＩＮＴＥＲ  ',seed:'Winter',majority:3,tie: false},
  {name:' winter ',seed:'Winter',majority:1,tie:true},
  {name:'  動畫  ',seed:'动画',majority:2,tie:false},
 ]){
  const f=await fixture();const reference=await fixture();try{
   const {createEntry}=await serverModule('repositories/entry-repository');
   const {createFacet,createSection}=await serverModule('repositories/layout-repository');
   const {assignEntryTag}=await serverModule('repositories/entry-tag-repository');
   const seed=(target:typeof f)=>{
    const low=createFacet(target.db,{sectionId:target.section.id,name:'Low'}).id;
    const high=createFacet(target.db,{sectionId:target.section.id,name:'High'}).id;
    assignEntryTag(target.db,{entryId:target.work.id,facetId:high,name:scene.seed});
    if(scene.seed==='Winter'){
     const section=createSection(target.db,{entryType:'Unstructured',name:'Existing only'});
     const facet=createFacet(target.db,{sectionId:section.id,name:'Existing'});
     assignEntryTag(target.db,{entryId:target.skipped.id,facetId:facet.id,name:scene.seed});
     target.db.prepare('DELETE FROM tag_groups WHERE id=?').run(section.defaultFacetId);
    }
    // Placements outside the Collection must participate; equal totals choose numeric low ID.
    for(let i=0;i<scene.majority;i++){const outside=createEntry(target.db,{title:`Outside ${i}`,type:'Comic'});assignEntryTag(target.db,{entryId:outside.id,facetId:low,name:scene.seed});}
    return {low,high};
   };
   const facets=seed(f);seed(reference);
   const expected=await reference.online.addCollectionTag(reference.parent.id,scene.name);
   const expectedAssignments=reference.db.prepare('SELECT entry_id AS entryId,facet_id AS facetId FROM entry_tags WHERE entry_id IN (?,?) ORDER BY entry_id').all(reference.work.id,reference.other.id);
   await f.offline();const result=await f.api.addCollectionTag(f.parent.id,scene.name);
   expect(result).toMatchObject({entriesAffected:expected.entriesAffected,alreadyPresent:expected.alreadyPresent,skipped:expected.skipped});expect(f.calls).toEqual([]);
   const original=(await f.store.list())[0]!;
   const cold=f.cold();await cold.preferOfflineSnapshot!();
   for(const assignment of expectedAssignments){const detail=await cold.getEntry(assignment.entryId);expect(detail.sections.flatMap(section=>section.facets).find(facet=>facet.id===assignment.facetId)?.tags).toContainEqual(expect.objectContaining({name:scene.seed}));}
   if(scene.seed==='Winter')expect(expectedAssignments).toContainEqual({entryId:f.other.id,facetId:facets.low});
   f.reconnect();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
   expect(f.db.prepare('SELECT entry_id AS entryId,facet_id AS facetId FROM entry_tags WHERE entry_id IN (?,?) ORDER BY entry_id').all(f.work.id,f.other.id)).toEqual(expectedAssignments);
   expect(f.db.prepare('SELECT count(*) FROM tags').pluck().get()).toBe(1);
   expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(original.opId)).toBe(1);
   expect(await f.store.list()).toEqual([]);
  }finally{f.close();reference.close();}
 }
});

it('retained unnamed default new Tag repeated bulk and empty blank scope use real own counters',async()=>{
 const f=await fixture();try{
  await f.offline();const versions=f.db.prepare('SELECT id,sync_version AS version FROM entries ORDER BY id').all();
  const expectedFacet=f.section.defaultFacetId;
  await f.api.addCollectionTag(f.parent.id,' 新標籤 ');
  const first=(await f.store.list())[0]!;
  expect(await f.api.addCollectionTag(f.parent.id,'新标签')).toMatchObject({entriesAffected:0,alreadyPresent:2,skipped:1});
  const rows=await f.store.list();expect(rows).toHaveLength(2);expect(rows[1]!.payload.tagUid).toBe(first.payload.tagUid);
  const cold=f.cold();await cold.preferOfflineSnapshot!();
  for(const id of [f.work.id,f.other.id])expect((await cold.getEntry(id)).sections.flatMap(section=>section.facets).find(facet=>facet.id===expectedFacet)?.tags).toEqual([expect.objectContaining({name:'新标签'})]);
  await expect(cold.addCollectionTag(f.parent.id,'　 ')).rejects.toThrow();expect(await f.store.list()).toHaveLength(2);expect(f.calls).toEqual([]);
  f.reconnect();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(await f.store.list()).toEqual([]);expect(f.db.prepare('SELECT count(*) FROM tags').pluck().get()).toBe(1);expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);
  expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id IN (?,?)').pluck().get(first.opId,rows[1]!.opId)).toBe(2);
  for(const row of versions)expect(f.db.prepare('SELECT sync_version FROM entries WHERE id=?').pluck().get(row.id)).toBe(row.version+(row.id===f.skipped.id?0:1));
  const {createCollection}=await serverModule('repositories/collection-repository');const empty=createCollection(f.db,{kind:'entry',title:'Empty'});
  await f.offline();expect(await f.api.addCollectionTag(empty.id,'Empty tag')).toMatchObject({entriesAffected:0,alreadyPresent:0,skipped:0});expect(f.calls).toEqual([]);
 }finally{f.close();}
});
it('retained each required false and genuinely absent capability blocks cold offline without HTTP or queue',async()=>{
 for(const flag of ['offlineMutations','offlineCollectionManagement','offlineCollectionCommonTag'])for(const missing of [false,true]){
  const f=await fixture();try{
   await f.offline();if(missing)await f.deleteCapability(flag);else await f.store.writeMeta('capability.'+flag,'0');
   const cold=f.cold();await cold.preferOfflineSnapshot!();expect(await f.store.readMeta('capability.'+flag)).toBe(missing?null:'0');
   await expect(cold.addCollectionTag(f.parent.id,'Winter')).rejects.toThrow('not available under offline');
   expect(f.calls).toEqual([]);expect(await f.store.list()).toEqual([]);expect(f.db.prepare('SELECT count(*) FROM tags').pluck().get()).toBe(0);
  }finally{f.close();}
 }
});
it('retained real attempted original stays exactly sealed through capability downgrade and cold reopen',async()=>{
 const f=await fixture();try{
  await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');f.reconnect();f.loseResponse();await f.api.getSyncCapabilities({replay:false});await f.api.replayOfflineOperations!();
  const original=(await f.store.list())[0]!;expect(original.lastAttemptAt).not.toBeNull();const exact=JSON.stringify(original);const body=f.bodies[0]!;
  expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(original.opId)).toBe(1);
  f.downgrade();const cold=f.cold();await cold.getSyncCapabilities({replay:false});f.calls.length=0;await cold.replayOfflineOperations!();
  expect(f.bodies).toEqual([body]);expect(JSON.stringify((await f.store.list())[0])).toBe(exact);
  await cold.preferOfflineSnapshot!();await expect(cold.addCollectionTag(f.parent.id,'Other')).rejects.toThrow('not available under offline');expect(f.calls).toEqual([]);
  expect(JSON.stringify((await f.store.list())[0])).toBe(exact);
 }finally{f.close();}
});
for(const oldCopy of [false,true])it(`retained connected ${oldCopy?'old copy new server folder':'no copy'} bounded pre-enqueue and cold original retry`,async()=>{
 const f=await fixture();try{
  if(oldCopy){await f.offline();f.reconnect();}
  const {createCollection,addCollectionEntry}=await serverModule('repositories/collection-repository');
  const folder=createCollection(f.db,{kind:'entry',title:'New server shelf',galleryType:'Comic'});addCollectionEntry(f.db,folder.id,f.work.id);addCollectionEntry(f.db,folder.id,f.other.id);
  const connected=oldCopy?f.cold():f.api;f.calls.length=0;let beforeEnqueue:string[]=[];const enqueue=f.store.enqueue.bind(f.store);
  const spy=vi.spyOn(f.store,'enqueue').mockImplementation(async operation=>{beforeEnqueue=[...f.calls];return enqueue(operation);});
  f.loseResponse();expect(await connected.addCollectionTag(folder.id,'Winter')).toMatchObject({entriesAffected:2,alreadyPresent:0,skipped:0});spy.mockRestore();
  expect(beforeEnqueue.some(call=>call.includes('common-tag-context'))).toBe(true);
  expect(beforeEnqueue.every(call=>!call.includes('snapshot')&&!call.includes('media')&&!call.startsWith('POST '))).toBe(true);
  expect(f.calls.some(call=>/^POST .*collections.*tags/.test(call))).toBe(false);
  const original=(await f.store.list())[0]!;expect(original.entityUid).toBe(f.db.prepare('SELECT sync_uid FROM collections WHERE id=?').pluck().get(folder.id));
  const fingerprint=operationFingerprint(original);const raw=f.bodies[0]!;expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);
  const cold=f.cold();f.loseAcknowledgement();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(await f.store.list()).toHaveLength(1);expect(operationFingerprint((await f.store.list())[0]!)).toBe(fingerprint);
  const retry=f.cold();await retry.getSyncCapabilities({replay:false});await retry.replayOfflineOperations!();
  expect(await f.store.list()).toEqual([]);expect(f.bodies.every(body=>body===raw)).toBe(true);
  expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(original.opId)).toBe(1);
  expect(JSON.stringify(await retry.getEntry(f.other.id))).toContain('Winter');
 }finally{f.close();}
});

it('causality bulk then folder delete settles both originals after SQL response and cold ACK loss',async()=>{
 const f=await fixture();try{
  await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');await f.api.deleteCollection(f.parent.id);
  const originals=await f.store.list();expect(originals.map(row=>row.operationKind)).toEqual(['collection.common-tag.add','collection.delete']);
  const fingerprints=originals.map(operationFingerprint);f.reconnect();f.loseResponse();await f.api.getSyncCapabilities({replay:false});await f.api.replayOfflineOperations!();
  expect((await f.store.list()).map(operationFingerprint)).toEqual(fingerprints);
  const cold=f.cold();f.loseAcknowledgement();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(f.db.prepare('SELECT count(*) FROM collections WHERE id IN (?,?)').pluck().get(f.parent.id,f.child.id)).toBe(0);
  expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);
  expect(f.db.prepare('SELECT count(*) FROM entries').pluck().get()).toBe(3);
  expect(f.db.prepare('SELECT count(*) FROM collection_entries WHERE collection_id=?').pluck().get(f.peer.id)).toBe(1);
  expect((await f.store.list()).map(operationFingerprint)).toEqual(fingerprints);
  const retry=f.cold();await retry.getSyncCapabilities({replay:false});await retry.replayOfflineOperations!();
  expect(await f.store.list()).toEqual([]);
  for(const row of originals){const bodies=f.bodies.filter(body=>JSON.parse(body).opId===row.opId);expect(new Set(bodies).size).toBe(1);expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(row.opId)).toBe(1);}
 }finally{f.close();}
});

it('causality later Entry tag removal covers only its exact bulk assignment after cold ACK loss',async()=>{
 const f=await fixture();try{
  await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');
  const detail=await f.api.getEntry(f.work.id);const tag=detail.sections.flatMap(section=>section.facets).flatMap(facet=>facet.tags)[0]!;
  await f.api.removeEntryTag(f.work.id,tag.id);
  const originals=await f.store.list();expect(originals.map(row=>row.operationKind)).toEqual(['collection.common-tag.add','entry.tags.set']);
  const bulk=originals[0]!;expect(originals[1]!.baseVersion).toBe((bulk.baseValues.members as Array<{syncUid:string;syncVersion:number}>).find(row=>row.syncUid===originals[1]!.entityUid)!.syncVersion+1);
  const fingerprints=originals.map(operationFingerprint);f.reconnect();f.loseResponse();await f.api.getSyncCapabilities({replay:false});await f.api.replayOfflineOperations!();
  const cold=f.cold();f.loseAcknowledgement();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(f.db.prepare('SELECT entry_id FROM entry_tags').pluck().all()).toEqual([f.other.id]);expect((await f.store.list()).map(operationFingerprint)).toEqual(fingerprints);
  const retry=f.cold();await retry.getSyncCapabilities({replay:false});await retry.replayOfflineOperations!();expect(await f.store.list()).toEqual([]);
  for(const row of originals){expect(new Set(f.bodies.filter(body=>JSON.parse(body).opId===row.opId)).size).toBe(1);expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(row.opId)).toBe(1);}
 }finally{f.close();}
});

it('causality connected held Entry predecessor forecasts bulk while independent owner progresses',async()=>{
 const f=await fixture();try{
  await f.offline();await f.api.updateEntry(f.work.id,{title:'Before bulk'});const prior=(await f.store.list())[0]!;
  await f.store.update(prior.opId,{status:'conflict',lastError:'held predecessor'});
  await f.api.updateEntry(f.skipped.id,{title:'Independent owner'});f.reconnect();const connected=f.cold();
  await connected.getSyncCapabilities({replay:false});f.calls.length=0;
  expect(await connected.addCollectionTag(f.parent.id,'Winter')).toMatchObject({entriesAffected:2});
  expect(f.calls.some(call=>call.includes('common-tag-context'))).toBe(true);expect(f.calls.some(call=>/^POST .*collections.*tags/.test(call))).toBe(false);
  expect(f.db.prepare('SELECT title FROM entries WHERE id=?').pluck().get(f.skipped.id)).toBe('Independent owner');
  expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(0);
  const retained=await f.store.list();expect(retained.map(row=>row.operationKind)).toEqual(['entry.update','collection.common-tag.add']);expect(operationFingerprint(retained[0]!)).toBe(operationFingerprint(prior));
  const bulk=retained[1]!;expect((bulk.baseValues.members as Array<{syncUid:string;syncVersion:number}>).find(row=>row.syncUid===prior.entityUid)!.syncVersion).toBe(prior.baseVersion+1);
  await f.store.update(prior.opId,{status:'pending',lastError:null});await connected.replayOfflineOperations!();expect(await f.store.list()).toEqual([]);
  expect(f.db.prepare('SELECT title FROM entries WHERE id=?').pluck().get(f.work.id)).toBe('Before bulk');expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);
 }finally{f.close();}
});

it('causality trusted local root child membership bulk delete restores originals and settles cold SQL ACK',async()=>{
 const f=await fixture();try{
  await f.offline();const root=await f.api.createCollection({kind:'entry',title:'Local root',galleryType:'Comic'});
  const child=await f.api.createCollection({kind:'entry',title:'Local child',parentId:root.id});
  await f.api.addCollectionEntry(root.id,f.work.id);await f.api.addCollectionEntry(child.id,f.other.id);
  await f.api.addCollectionTag(root.id,'Winter');await f.api.deleteCollection(root.id);
  const originals=await f.store.list();expect(originals.map(row=>row.operationKind)).toEqual(['collection.create','collection.create','collection.entry.set','collection.entry.set','collection.common-tag.add','collection.delete']);
  const text=JSON.stringify(await buildPendingWorkExport(f.store));await f.store.removeMany(originals.map(row=>row.opId));let cold=f.cold();await cold.restorePendingWork!(text);expect(await f.store.list()).toEqual(originals);
  await f.store.update(originals[1]!.opId,{status:'conflict',lastError:'held origin'});f.reconnect();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
  expect(f.db.prepare('SELECT count(*) FROM tags').pluck().get()).toBe(0);expect((await f.store.list()).some(row=>row.operationKind==='collection.delete')).toBe(true);
  await f.store.update(originals[1]!.opId,{status:'pending',lastError:null});f.loseResponse();await cold.replayOfflineOperations!();
  const attempted=await f.store.list();const exported=JSON.stringify(await buildPendingWorkExport(f.store));await f.store.removeMany(attempted.map(row=>row.opId));cold=f.cold();await cold.restorePendingWork!(exported);expect(await f.store.list()).toEqual(attempted);
  f.loseAcknowledgement();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();expect(await f.store.list()).not.toEqual([]);
  expect(f.db.prepare('SELECT count(*) FROM collections WHERE title LIKE ?').pluck().get('Local%')).toBe(0);expect(f.db.prepare('SELECT count(*) FROM entry_tags').pluck().get()).toBe(2);
  const ackExport=JSON.stringify(await buildPendingWorkExport(f.store));const afterAck=await f.store.list();await f.store.removeMany(afterAck.map(row=>row.opId));cold=f.cold();await cold.restorePendingWork!(ackExport);expect(await f.store.list()).toEqual(afterAck);
  cold=f.cold();await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();expect(await f.store.list()).toEqual([]);
  expect(f.db.prepare('SELECT count(*) FROM entries').pluck().get()).toBe(3);expect(f.db.prepare('SELECT count(*) FROM collection_entries WHERE collection_id=?').pluck().get(f.peer.id)).toBe(1);
  for(const row of originals){const bodies=f.bodies.filter(body=>JSON.parse(body).opId===row.opId);expect(new Set(bodies).size).toBe(1);expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id=?').pluck().get(row.opId)).toBe(1);}
 }finally{f.close();}
});

// Finite close cell 1: frozen scope and global placement context, two actual SQL changes.
it('finite close frozen scope and global context conflict with zero partial SQL writes',async()=>{
 for(const scene of ['scope','context']){
  const f=await fixture();try{
   await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');
   const original=(await f.store.list())[0]!;const stored=JSON.stringify(original);
   const {status,lastAttemptAt,lastError,...operation}=original;void status;void lastAttemptAt;void lastError;
   if(scene==='scope')f.db.prepare('DELETE FROM collection_entries WHERE collection_id=? AND entry_id=?').run(f.child.id,f.other.id);
   else {
    const {createEntry}=await serverModule('repositories/entry-repository');
    const {createFacet}=await serverModule('repositories/layout-repository');
    const {assignEntryTag}=await serverModule('repositories/entry-tag-repository');
    const facet=createFacet(f.db,{sectionId:f.section.id,name:'Changed global majority'});
    const outside=createEntry(f.db,{title:'Outside scope',type:'Comic'});
    assignEntryTag(f.db,{entryId:outside.id,facetId:facet.id,name:'Winter'});
   }
   const state=()=>['tags','entry_tags','sync_changes'].map(table=>f.db.prepare(`SELECT * FROM ${table}`).all());
   const before=state();f.reconnect();
   expect(await f.online.replaySyncOperation!(operation as Parameters<NonNullable<typeof f.online.replaySyncOperation>>[0])).toMatchObject({opId:original.opId,status:'conflict'});
   expect(state()).toEqual(before);expect(JSON.stringify((await f.store.list())[0])).toBe(stored);
   expect(f.db.prepare('SELECT count(*) FROM entry_tags WHERE entry_id IN (?,?)').pluck().get(f.work.id,f.other.id)).toBe(0);
   expect(await f.online.replaySyncOperation!(operation as Parameters<NonNullable<typeof f.online.replaySyncOperation>>[0])).toMatchObject({status:'conflict'});
   expect(f.bodies[1]).toBe(f.bodies[0]);expect(state()).toEqual(before);
  }finally{f.close();}
 }
});

// Finite close cell 2: corrupt only real SQL response proof, never synthesize applied success.
it('finite close foreign real receipt and successor journal cannot clear retained originals',async()=>{
 for(const variant of ['tagUid','successorRecord']){
  const f=await fixture();try{
   await f.offline();await f.api.addCollectionTag(f.parent.id,'Winter');
   const detail=await f.api.getEntry(f.work.id);const tag=detail.sections.flatMap(section=>section.facets).flatMap(facet=>facet.tags)[0]!;
   await f.api.removeEntryTag(f.work.id,tag.id);
   const originals=await f.store.list();const fingerprints=originals.map(operationFingerprint);
   const bulk=originals[0]!;const successor=originals[1]!;let tampered=0;
   f.tamperResponse(async(path,response)=>{
    if(!response.ok)return response;
    if(variant==='tagUid' && path==='/api/sync/replay'){
     const data=await response.clone().json();
     if(data.opId===bulk.opId && data.status==='applied'){data.collectionCommonTag.tagUid=randomUUID();tampered++;return new Response(JSON.stringify(data),{status:200,headers:{'content-type':'application/json'}});}
    }
    if(variant==='successorRecord' && path==='/api/sync/changes'){
     const receipt=f.db.prepare('SELECT result_json FROM sync_operation_receipts WHERE op_id=?').pluck().get(successor.opId);
     if(typeof receipt==='string'){
      const seq=JSON.parse(receipt).serverSeq;const data=await response.clone().json();
      for(const change of data.changes)if(change.seq===seq && change.entityUid===successor.entityUid){change.record.id=f.other.id;tampered++;}
      return new Response(JSON.stringify(data),{status:200,headers:{'content-type':'application/json'}});
     }
    }
    return response;
   });
   f.reconnect();const cold=f.cold();const removed=vi.spyOn(f.store,'removeMany');
   await cold.getSyncCapabilities({replay:false});await cold.replayOfflineOperations!();
   expect(tampered).toBeGreaterThan(0);expect(removed).not.toHaveBeenCalled();removed.mockRestore();
   expect((await f.store.list()).map(operationFingerprint)).toEqual(fingerprints);
   const retained=JSON.stringify(await f.store.list());const retry=f.cold();expect(JSON.stringify(await f.store.list())).toBe(retained);
   expect(f.db.prepare('SELECT count(*) FROM sync_operation_receipts WHERE op_id IN (?,?)').pluck().get(bulk.opId,successor.opId)).toBe(variant==='tagUid'?1:2);
   expect(f.db.prepare('SELECT entry_id FROM entry_tags ORDER BY entry_id').pluck().all()).toEqual(variant==='tagUid'?[f.work.id,f.other.id]:[f.other.id]);
   f.tamperResponse(undefined);await retry.getSyncCapabilities({replay:false});await retry.replayOfflineOperations!();expect(await f.store.list()).toEqual([]);
   for(const row of originals)expect(new Set(f.bodies.filter(body=>JSON.parse(body).opId===row.opId)).size).toBe(1);
  }finally{f.close();}
 }
});
